# ==============================================================================
# Observability Stack — variáveis de ambiente
#
# Copie este arquivo para `.env` e ajuste os valores antes de subir a stack:
#   cp .env.example .env
#
# O arquivo `.env` NUNCA deve ser commitado (já está no .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# Timezone
# ------------------------------------------------------------------------------
# Usado por todos os containers (Grafana, Prometheus, Loki, Alloy, exporters)
# para que timestamps em logs, dashboards e alertas fiquem no fuso horário
# correto. Sem isso, os containers assumem UTC por padrão — o que costuma
# confundir a correlação entre "agora" no seu relógio e os gráficos.
TZ=America/Sao_Paulo

# Nome/identificador desta VPS. Vira o label `host` em métricas e logs,
# permitindo diferenciar esta máquina de outras que você venha a adicionar
# no futuro (ver seção "Adicionando novos serviços/exporters" no README).
# Sugestão: rode `hostname` na VPS e use o resultado aqui.
VPS_HOSTNAME=vps-01

# ------------------------------------------------------------------------------
# Grafana
# ------------------------------------------------------------------------------
# Porta publicada no host. Grafana é o único serviço da stack exposto
# fora da rede Docker interna.
GRAFANA_PORT=3000

# Credenciais do usuário admin, criadas automaticamente no primeiro boot.
# Troque GRAFANA_ADMIN_PASSWORD por uma senha forte antes de subir em produção.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# Domínio público do Grafana, se houver (usado em GF_SERVER_ROOT_URL quando
# a stack estiver atrás de um reverse proxy com HTTPS). Deixe como localhost
# se for acessar apenas via IP/porta direta.
GRAFANA_ROOT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Retenção de dados
# ------------------------------------------------------------------------------
# Prometheus: quantos dias de métricas manter. 15 dias é suficiente para
# analisar tendências recentes sem consumir disco indefinidamente numa VPS.
PROMETHEUS_RETENTION_DAYS=15d
# Limite de tamanho em disco como proteção extra (o que vier primeiro vence).
PROMETHEUS_RETENTION_SIZE=5GB

# Loki: quantos dias de logs manter. 14 dias cobre a janela típica de
# investigação de incidentes sem acumular volume excessivo de chunks.
LOKI_RETENTION_DAYS=14d

# ------------------------------------------------------------------------------
# Limites de recursos da própria stack (ajuste para VPS com pouca RAM/CPU)
# ------------------------------------------------------------------------------
GRAFANA_MEM_LIMIT=256m
PROMETHEUS_MEM_LIMIT=768m
LOKI_MEM_LIMIT=512m
ALLOY_MEM_LIMIT=256m
CADVISOR_MEM_LIMIT=256m
NODE_EXPORTER_MEM_LIMIT=128m

# ------------------------------------------------------------------------------
# Alertas — canais de notificação (opcional)
# ------------------------------------------------------------------------------
# Deixe em branco para manter os contact points desativados. Preencha quando
# quiser habilitar notificações reais (ver grafana/provisioning/alerting/).
# ALERT_SMTP_ENABLED só deve virar "true" depois de preencher os campos SMTP.
ALERT_SMTP_ENABLED=false
ALERT_SMTP_HOST=
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_SMTP_FROM_ADDRESS=alerts@example.com

# Os quatro campos abaixo já vêm com placeholders (em vez de vazios) de
# propósito: o provisionamento de alerting do Grafana valida o formato de
# URL/token no boot, e um valor vazio quebraria a stack ao subir. Troque os
# placeholders pelos valores reais quando for habilitar o canal — até lá,
# eles ficam definidos mas inofensivos (só falham ao tentar notificar, não
# ao iniciar o Grafana).
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGE/ME/NOW
ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGE/ME
ALERT_TELEGRAM_BOT_TOKEN=CHANGE_ME
ALERT_TELEGRAM_CHAT_ID=CHANGE_ME
ALERT_GENERIC_WEBHOOK_URL=https://example.com/change-me
